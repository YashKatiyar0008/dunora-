# Local: DATABASE_URL=sqlite:///./dunora.db
DATABASE_URL=sqlite:///./dunora.db
COOKIE_SECURE=false
ALLOW_PUBLIC_DEMO=true
# HTTPS canonical origin; required for Stripe checkout and origin validation on production.
APP_URL=
# All Stripe credentials are server-side; configure actual monthly Price IDs in INR.
STRIPE_SECRET_KEY=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
STRIPE_WEBHOOK_SECRET=
# Optional: reminders otherwise enter a clearly labeled simulated state.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
